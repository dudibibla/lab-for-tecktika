# Application
APP_NAME=Backend Agent API
ENVIRONMENT=local
ALLOW_LOCAL_AUTH_BYPASS=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://<your-static-web-app>.azurestaticapps.net

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=
AZURE_SEARCH_SEMANTIC_CONFIGURATION_NAME=document-content-semantic

# Azure AI Search schema fields
AAS_FIELD_CHUNK_ID=chunkId
AAS_FIELD_PARENT_DOCUMENT_ID=parentDocumentId
AAS_FIELD_FILE_NAME=fileName
AAS_FIELD_CONTENT=content
AAS_FIELD_PAGE=page
AAS_FIELD_SOURCE_URL=sourceUrl
AAS_FIELD_VECTOR=text_vector

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure Storage
AZURE_STORAGE_ACCOUNT_NAME=

# Blob Storage
BLOB_CONTAINER_NAME=pdf-library
STAGING_CONTAINER_NAME=

# Queue Storage
STORAGE_QUEUE_NAME=index-jobs

# Table Storage
JOB_STATUS_TABLE_NAME=jobstatus
# Optional; defaults to JOB_STATUS_TABLE_NAME when left empty.
CONVERSATION_HISTORY_TABLE_NAME=

# Job configuration
JOB_STATUS_QUEUED=QUEUED
JOB_STATUS_RUNNING=RUNNING
JOB_STATUS_SUCCEEDED=SUCCEEDED
JOB_STATUS_FAILED=FAILED

# App authorization
AUTH_DEFAULT_ROLE=
